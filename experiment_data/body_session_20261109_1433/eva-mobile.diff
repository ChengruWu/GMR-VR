+def test_body_disconnect_stops_publication_and_requires_reset_on_reconnect():
+    class Backend:
+        def reset(self):
+            pass
+
+        def step(self, request):
+            return GmrResult("ok", dict.fromkeys(LUNA_JOINTS, 0.0))
+
+    class Transport:
+        def __init__(self):
+            self.commands = []
+
+        def get_latest_teleop_feedback(self):
+            return {"qpos": np.zeros(24), "receipt_age_s": 0.01, "disabled_groups": []}
+
+        def publish_action(self, action, **kwargs):
+            self.commands.append(action.copy())
+
+    client = make_client()
+    client._backend = Backend()
+    frame, _ = normalize_browser_frame(browser_frame(), session_id="session")
+    for side in ("left", "right"):
+        frame["controllers"][side]["grip_engaged"] = True
+    client._ingest(json.dumps(frame).encode())
+    transport = Transport()
+    runtime = SimpleNamespace(
+        robot=SimpleNamespace(name="gento_luna", total_action_dim=24, gripper_indices=(7, 15)),
+        transport=transport,
+    )
+    state = teleop.TeleopExecutionState(active=True)
+    assert teleop._step_active_teleop(None, runtime, state, client, time.monotonic()) is not None
+    client._ingest({"protocol": "eva.teleop.vr", "version": 3, "type": "heartbeat",
+                    "session_id": "session", "browser_connected": False,
+                    "source_error": "headset disconnected"})
+    assert teleop._step_active_teleop(None, runtime, state, client, time.monotonic()) is None
+    assert len(transport.commands) == 1
+    frame["seq"] += 1
+    frame["body"]["sample_sequence"] += 1
+    client._ingest(json.dumps(frame).encode())
+    assert teleop._step_active_teleop(None, runtime, state, client, time.monotonic()) is None
+    assert len(transport.commands) == 1
+    for side in ("left", "right"):
+        frame["controllers"][side]["grip_engaged"] = False
+    frame["seq"] += 1
+    frame["body"]["sample_sequence"] += 1
+    client._ingest(json.dumps(frame).encode())
+    assert teleop._step_active_teleop(None, runtime, state, client, time.monotonic()) is None
+    for side in ("left", "right"):
+        frame["controllers"][side]["grip_engaged"] = True
+    frame["seq"] += 1
+    frame["body"]["sample_sequence"] += 1
+    client._ingest(json.dumps(frame).encode())
+    assert teleop._step_active_teleop(None, runtime, state, client, time.monotonic()) is None
+    assert "reset" in state.last_fault
+    assert len(transport.commands) == 1
+
+
