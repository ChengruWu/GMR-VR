+def test_runtime_valid_flags_do_not_allow_missing_joint_orientations():
+    # PICO firmware can report all joints valid even when their quaternions are zero.
+    # EVA-VR forwards those orientations as null while preserving the runtime flags.
+    raw = browser_frame()
+    raw["body"]["runtime_all_joint_locations_valid"] = True
+    raw["body"]["status"] = "tracking incomplete"
+    for joint in raw["body"]["joints"]:
+        joint["location_flags"] = 15
+        joint["orientation_xyzw"] = None
+    frame, _ = normalize_browser_frame(raw, session_id="session")
+    for hand in ("left", "right"):
+        frame["controllers"][hand]["grip_engaged"] = True
+
+    class Backend:
+        def reset(self):
+            pass
+
+        def step(self, request):
+            pytest.fail("incomplete tracking must not reach the solver")
+
+    client = make_client()
+    client._backend = Backend()
+    client._ingest(json.dumps(frame).encode())
+    context = TeleopContext(
+        measured_qpos=np.zeros(24), measured_eef=np.empty(0),
+        now=time.monotonic(), base_feedback_age_s=0.01,
+    )
+    result = client.poll(context)
+    assert result.kind is TeleopResultKind.REJECTED
+    assert "incomplete" in result.message
+    assert result.command is None
+
