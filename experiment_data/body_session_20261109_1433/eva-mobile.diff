+def test_real_body_backend_accepts_model_feedback_after_command():
+    mujoco = pytest.importorskip("mujoco")
+    gmr = pytest.importorskip("gmr_body")
+    yaml = pytest.importorskip("yaml")
+    backend = gmr.create_backend()
+    # Synthetic kinematic exercise only; production defaults remain unchanged.
+    backend.config.update(
+        allow_unvalidated_output=True, max_solve_s=10,
+        max_input_age_s=10, max_feedback_age_s=10,
+    )
+    client = make_client()
+    client._backend = backend
+    client._input_timeout_s = 10
+    data = mujoco.MjData(backend.engine.model)
+
+    class ModelTransport:
+        def __init__(self):
+            profile = Path(__file__).resolve().parents[2] / "examples/hardware/gento_luna/config.yaml"
+            config = yaml.safe_load(profile.read_text(encoding="utf-8"))
+            self.qpos = np.asarray(
+                config["robot"]["gento_luna"]["config"]["robot"]["initial_qpos"], dtype=float
+            )
+            self.commands = []
+
+        def get_latest_teleop_feedback(self):
+            return {"qpos": self.qpos.copy(), "receipt_age_s": 0.01, "disabled_groups": []}
+
+        def publish_action(self, action, **kwargs):
+            self.qpos = np.asarray(action).copy()
+            self.commands.append(self.qpos.copy())
+            data.qpos[backend.addresses] = self.qpos
+            mujoco.mj_forward(backend.engine.model, data)
+
+    transport = ModelTransport()
+    runtime = SimpleNamespace(
+        robot=SimpleNamespace(name="gento_luna", total_action_dim=24, gripper_indices=(7, 15)),
+        transport=transport,
+    )
+    state = teleop.TeleopExecutionState(active=True)
+    positions = {
+        "pelvis": (0, 1, 0), "spine3": (0, 1.4, 0), "head": (0, 1.7, 0),
+        "left_shoulder": (-0.2, 1.4, 0), "right_shoulder": (0.2, 1.4, 0),
+        "left_elbow": (-0.4, 1.2, 0), "right_elbow": (0.4, 1.2, 0),
+        "left_wrist": (-0.5, 1, 0), "right_wrist": (0.5, 1, 0),
+    }
+    for seq in range(1, 4):
+        raw = browser_frame()
+        raw["seq"] = seq
+        raw["body"].update(
+            sample_sequence=seq, units="metres", joint_space="base_space",
+            orientation_order="xyzw", runtime_all_joint_locations_valid=True,
+        )
+        for joint in raw["body"]["joints"]:
+            joint["position"] = positions.get(joint["name"], (0, 1, 0))
+        frame, _ = normalize_browser_frame(raw, session_id="synthetic-sim")
+        for side in ("left", "right"):
+            frame["controllers"][side]["grip_engaged"] = True
+        client._ingest(json.dumps(frame).encode())
+        teleop._step_active_teleop(None, runtime, state, client, time.monotonic())
+    assert len(transport.commands) == 2, state.last_fault
+    assert np.isfinite(data.qpos).all()
+
